# Copy this file to .env. Never commit .env: it contains Foundry credentials.
# Use either FOUNDRY_RELEASE_URL or the FOUNDRY_USERNAME/PASSWORD pair.
FOUNDRY_RELEASE_URL=
FOUNDRY_USERNAME=you@example.com
FOUNDRY_PASSWORD=your-foundryvtt.com-password

# Foundry setup access key used only by this local disposable instance.
FOUNDRY_ADMIN_KEY=change-me

# Explicit opt-in for the local harness to accept Foundry's EULA on first run.
# Setting this to true confirms that you have reviewed and accept that agreement.
FOUNDRY_EULA_ACCEPT=false

# Playwright target and disposable world login.
FOUNDRY_TEST_PORT=30000
FOUNDRY_URL=http://127.0.0.1:30000
FOUNDRY_TEST_WORLD=mindflayer-smoke
FOUNDRY_TEST_USER=Gamemaster
FOUNDRY_TEST_PASSWORD=change-me-too
