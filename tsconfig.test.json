{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.json",
    "src/js/**/*.js",
    "src/js/**/*.ts",
    "src/js/**/*.d.ts"
  ]
}
